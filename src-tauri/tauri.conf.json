{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Indoor Report Generator",
  "version": "2.0.1",
  "identifier": "com.vinfocom.indoorreport",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Indoor Report Generator",
        "width": 1240,
        "height": 860,
        "minWidth": 980,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../backend-publish": "backend"
    }
  }
}
