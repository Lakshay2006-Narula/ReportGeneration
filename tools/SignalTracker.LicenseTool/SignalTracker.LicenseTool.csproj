<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>STracerLicenseGenerator</AssemblyName>
    <ApplicationIcon>..\..\src-tauri\icons\icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- Signing keys must remain external to the generator binary. -->
  <Target Name="RejectEmbeddedSigningKey" BeforeTargets="CoreCompile">
    <ItemGroup>
      <SigningKeyResource Include="@(EmbeddedResource)"
        Condition="'%(EmbeddedResource.Filename)%(EmbeddedResource.Extension)' == 'private-key.txt' Or '%(EmbeddedResource.LogicalName)' == 'private-key.txt'" />
    </ItemGroup>
    <Error Condition="'@(SigningKeyResource)' != ''"
      Text="Private signing keys must never be embedded in the license generator." />
  </Target>
</Project>
